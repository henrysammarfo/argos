# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# Fetch.ai / ASI:One
ASI_ONE_API_KEY=your_asi_one_api_key
AGENTVERSE_API_KEY=your_agentverse_api_key

# Kaspa (use api-tn10.kaspa.org for kaspatest addresses)
KASPA_NODE_URL=https://api-tn10.kaspa.org
KASPA_NETWORK=kaspatest
KASPA_PRIVATE_KEY=your_hex_private_key
KASPA_SEED_PHRASE=optional_seed_phrase_instead
ESCROW_WALLET_ADDRESS=your_escrow_wallet_address
PROGRAM_ADMIN_ADDRESS=program_admin_kaspa_address

# Database — PostgreSQL required in production
DATABASE_URL=postgresql://argos:argos@localhost:5432/argos

# App
ENV=development
PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_HOSTS=
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=168

# Performance / scaling
WEB_CONCURRENCY=4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
EVAL_CONCURRENCY=5

# Agent addresses (filled after running agents)
ORCHESTRATOR_ADDRESS=
INTAKE_ADDRESS=
TECHNICAL_ADDRESS=
IMPACT_ADDRESS=
TEAM_ADDRESS=
MILESTONE_ADDRESS=
