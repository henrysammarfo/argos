# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# Fetch.ai / ASI:One
ASI_ONE_API_KEY=your_asi_one_api_key
AGENTVERSE_API_KEY=your_agentverse_api_key

# Kaspa
KASPA_NODE_URL=https://api.kaspa.org
KASPA_NETWORK=mainnet
KASPA_SEED_PHRASE=your_kaspa_wallet_seed_phrase
ESCROW_WALLET_ADDRESS=your_escrow_wallet_address
PROGRAM_ADMIN_ADDRESS=program_admin_kaspa_address

# Database (SQLite fallback if unset)
DATABASE_URL=postgresql://argos:password@localhost:5432/argos

# App
PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ADMIN_API_KEY=change-me-in-production

# Agent addresses (filled after running agents)
ORCHESTRATOR_ADDRESS=
INTAKE_ADDRESS=
TECHNICAL_ADDRESS=
IMPACT_ADDRESS=
TEAM_ADDRESS=
MILESTONE_ADDRESS=
