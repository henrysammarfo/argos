# Copy to .env.production on your VPS (never commit real values)
# Postgres: use Neon free tier — https://neon.tech

ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=generate_with_openssl_rand_hex_32
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Set after Vercel deploy
CORS_ORIGINS=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app

KASPA_NODE_URL=https://api-tn10.kaspa.org
KASPA_NETWORK=kaspatest
ESCROW_WALLET_ADDRESS=kaspatest:...
PROGRAM_ADMIN_ADDRESS=kaspatest:...
KASPA_PRIVATE_KEY=...

AGENTVERSE_API_KEY=...
ASI_ONE_API_KEY=...
ORCHESTRATOR_ADDRESS=agent1q...
INTAKE_ADDRESS=agent1q...
TECHNICAL_ADDRESS=agent1q...
IMPACT_ADDRESS=agent1q...
TEAM_ADDRESS=agent1q...
MILESTONE_ADDRESS=agent1q...

WEB_CONCURRENCY=2
EVAL_CONCURRENCY=5
